---
interface Props {
  sketch: string;
}

const { sketch } = Astro.props;
---

<div class="p5-canvas-wrapper">
  <div class="p5-mount" data-sketch={sketch}></div>
</div>
<button class="capture-btn" data-sketch={sketch} type="button">
  PNG をダウンロード
</button>

<style>
  .capture-btn {
    display: block;
    margin: 0.75rem auto 2rem;
    padding: 0.4rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: 0.8rem;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }

  .capture-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
</style>

<script>
  import p5 from "p5";

  // p5 インスタンスをスケッチ名で保持（WEBGL の saveCanvas 用）
  const instances = new Map<string, p5>();

  document.querySelectorAll<HTMLDivElement>(".p5-mount").forEach(async (el) => {
    const name = el.dataset.sketch;
    if (!name) return;

    const modules = import.meta.glob<{ default: (p: p5) => void }>(
      "../sketches/*.js",
      { eager: false }
    );

    const key = `../sketches/${name}.js`;
    const loader = modules[key];
    if (!loader) {
      console.error(`Sketch not found: ${name}`);
      return;
    }

    const mod = await loader();
    const inst = new p5(mod.default, el);
    instances.set(name, inst);
  });

  document.querySelectorAll<HTMLButtonElement>(".capture-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const name = btn.dataset.sketch;
      if (!name) return;

      const inst = instances.get(name);
      if (inst) {
        // p5.saveCanvas は WEBGL でもバッファを正しく取得する
        inst.saveCanvas(name, "png");
      }
    });
  });
</script>
